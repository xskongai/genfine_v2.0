                        FunctionLabel.DIRECT_QUOTATION,
                        FunctionLabel.GROUP_GENERALIZATION,
                    ],
                    necessity=NecessityAnnotation(
                        status=Necessity.ESSENTIAL,
                        reasons=[
                            NecessityReason.QUOTATION_FIDELITY,
