                    number="PLURAL",
                    specificity="GENERIC",
                    identity_relevance=True,
                    description="被职业刻板印象概括的女性群体",
                )
            ],
            spans=[
                AnalysisSpan(
                    span_id="s1",
                    text=text,
                    start=0,
                    end=len(text),
                    cue_type=GenderCueType.STEREOTYPICAL_ATTRIBUTE,
                    explicitness=Explicitness.EXPLICIT,
                    gender_dimension=GenderDimension.SOCIAL_GENDER_ROLE,
                    gender_value=GenderValue.FEMALE,
                    referent_id="women_group",
                    source=GenderSource.AUTHOR_ASSIGNED,
                    source_reliability=SourceReliability.CONFIRMED,
                    functions=[FunctionLabel.GROUP_GENERALIZATION],
                    necessity=NecessityAnnotation(
                        status=Necessity.INCIDENTAL,
                        reasons=[NecessityReason.NO_COMMUNICATIVE_RELEVANCE],
                        rationale="护理职业适任性不应由性别群体特征推导。",
                    ),
                    bias=BiasAnnotation(
                        status=BiasStatus.EXPLICIT,
                        mechanisms=[
                            BiasMechanism.POSITIVE_STEREOTYPE,
                            BiasMechanism.PRESCRIPTIVE_ROLE_NORM,
                        ],
                        rationale="正向特质概括仍将女性与护理职业绑定。",
                    ),
                    stance=SpeakerStance.ENDORSE,
                )
            ],
            protected_facts=[
                ProtectedFact(
                    fact_id="f1",
                    fact_type=ProtectedFactType.OTHER,
                    description="原命题讨论从事护理工作的适合性",
                    source_span_ids=[],
                    must_preserve=True,
                    required_output_phrases=[
                        "护理",
                    ],
                    forbidden_output_phrases=[
                        "女性更细心",
                        "女性更适合做护士",
                    ],
                    verification_hint=(
                        "保留护理职业主题，但不得把职业适合性归因于女性群体。"
                    ),
                ),
            ],
            speaker_stance=SpeakerStance.ENDORSE,
            context_sufficient=True,
            analysis_notes="正向刻板印象和职业角色规定并不等于包容表达。",
        ),
        gold_decision=DecisionAnnotation(
            instance_action=InstanceAction.EDIT,
            edit_scope=EditScope.SENTENCE,
            span_actions=[
                SpanActionAnnotation(
                    span_id="s1",
                    action=Action.REFRAME_PROPOSITION,
                    reason_code="ENDORSED_GENDER_STEREOTYPE",
                    rationale="改为以个人能力、训练和意愿为依据的职业表述。",
                )
            ],
