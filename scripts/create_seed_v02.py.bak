OUTPUT_PATH = PROJECT_ROOT / "data" / "seed" / "seed_v0.2.jsonl"


def build_routine_gender_marking_instance() -> DatasetInstance:
    """Routine clinical log: occupational gender marking is incidental."""

    text = "女医生李敏完成了这台手术"
    gold_output = "医生李敏完成了这台手术"

    return DatasetInstance(
        instance_id="zh_seed_0006",
        language="zh",
        task_mode=TaskMode.INCLUSIVE_REWRITING,
        context=TextContext(
            preceding_context="以下是当日手术完成情况的常规记录。",
            target_text=text,
            following_context="记录仅用于交接手术进度。",
            genre="clinical_operation_log",
            speaker="hospital_record_system",
            audience="medical_staff",
            communicative_goal="record_operation_completion",
            cultural_context="modern_chinese",
        ),
        gold_analysis=AnalysisResult(
            referents=[
                Referent(
                    referent_id="doctor_li",
                    referent_type=ReferentType.SPECIFIC_PERSON,
                    number="SINGULAR",
                    specificity="KNOWN",
                    identity_relevance=False,
                    description="完成手术的李敏医生",
                )
            ],
            spans=[
                AnalysisSpan(
                    span_id="s1",
                    text="女",
                    start=0,
                    end=1,
                    cue_type=GenderCueType.OCCUPATION_MARKER,
                    explicitness=Explicitness.EXPLICIT,
                    gender_dimension=GenderDimension.SOCIAL_GENDER_ROLE,
                    gender_value=GenderValue.FEMALE,
                    referent_id="doctor_li",
                    source=GenderSource.AUTHOR_ASSIGNED,
                    source_reliability=SourceReliability.CONFIRMED,
                    functions=[FunctionLabel.IDENTIFICATION],
                    necessity=NecessityAnnotation(
                        status=Necessity.INCIDENTAL,
                        reasons=[NecessityReason.NO_COMMUNICATIVE_RELEVANCE],
                        rationale=(
                            "常规手术日志中，医生的性别与事件记录无关。"
                        ),
                    ),
                    bias=BiasAnnotation(
                        status=BiasStatus.IMPLICIT,
                        mechanisms=[BiasMechanism.UNNECESSARY_GENDER_MARKING],
                        rationale="职业前的性别标记在该语境中构成不必要突出。",
                    ),
                    stance=SpeakerStance.NEUTRAL_REPORT,
                )
            ],
            protected_facts=[
                ProtectedFact(
                    fact_id="f1",
                    fact_type=ProtectedFactType.OTHER,
                    description="李敏是一名完成该手术的医生",
                    source_span_ids=[],
                    must_preserve=True,
                    required_output_phrases=[
                        "医生",
                        "李敏",
                        "手术",
                    ],
                    verification_hint=(
                        "只能删除性别标记“女”，必须保留职业、姓名和事件。"
                    ),
                ),
            ],
            speaker_stance=SpeakerStance.NEUTRAL_REPORT,
            context_sufficient=True,
            analysis_notes="常规职业记录中的不必要性别标记案例。",
        ),
        gold_decision=DecisionAnnotation(
            instance_action=InstanceAction.EDIT,
            edit_scope=EditScope.SPAN,
            span_actions=[
                SpanActionAnnotation(
                    span_id="s1",
                    action=Action.UNMARK,
                    reason_code="INCIDENTAL_GENDER_MARKING",
                    rationale="删除与常规日志目的无关的职业性别标记。",
                )
            ],
        ),
        gold_output=gold_output,
        metadata=DatasetMetadata(
            source_type="controlled_context_pair",
            scenario_category="unnecessary_occupational_gender_marking",
            annotation_version="v0.2",
            notes="与 zh_seed_0007 构成上下文翻转对。",
        ),
    )


def build_representational_gender_marking_instance() -> DatasetInstance:
    """Same target sentence, but gender is relevant to representation tracking."""

    text = "女医生李敏完成了这台手术"

    return DatasetInstance(
        instance_id="zh_seed_0007",
        language="zh",
        task_mode=TaskMode.INCLUSIVE_REWRITING,
        context=TextContext(
            preceding_context="该项目正在记录女性外科医生参与高难度手术的情况。",
            target_text=text,
            following_context="这条记录将纳入女性外科医生参与度统计。",
            genre="representation_monitoring_report",
            speaker="research_team",
            audience="researchers",
            communicative_goal="document_women_surgeon_participation",
            cultural_context="modern_chinese",
        ),
        gold_analysis=AnalysisResult(
            referents=[
                Referent(
                    referent_id="doctor_li",
                    referent_type=ReferentType.SPECIFIC_PERSON,
                    number="SINGULAR",
                    specificity="KNOWN",
                    identity_relevance=True,
                    description="参与女性外科医生项目记录的李敏",
                )
            ],
            spans=[
                AnalysisSpan(
                    span_id="s1",
                    text="女医生",
                    start=0,
                    end=3,
                    cue_type=GenderCueType.OCCUPATION_MARKER,
                    explicitness=Explicitness.EXPLICIT,
                    gender_dimension=GenderDimension.SOCIAL_GENDER_ROLE,
                    gender_value=GenderValue.FEMALE,
                    referent_id="doctor_li",
                    source=GenderSource.DOCUMENTED_RECORD,
                    source_reliability=SourceReliability.CONFIRMED,
                    functions=[
                        FunctionLabel.IDENTIFICATION,
                        FunctionLabel.REPRESENTATIONAL_VISIBILITY,
                    ],
                    necessity=NecessityAnnotation(
                        status=Necessity.RELEVANT,
                        reasons=[NecessityReason.REPRESENTATIONAL_RELEVANCE],
                        rationale=(
                            "当前记录的目的正是统计女性外科医生的参与情况，"
                            "删除性别信息会破坏记录功能。"
                        ),
                    ),
                    bias=BiasAnnotation(
                        status=BiasStatus.NONE,
                        mechanisms=[],
                        rationale="性别信息服务于明确的代表性统计目的。",
                    ),
                    stance=SpeakerStance.NEUTRAL_REPORT,
                )
            ],
            protected_facts=[
                ProtectedFact(
                    fact_id="f1",
                    fact_type=ProtectedFactType.OTHER,
                    description="李敏作为女性医生完成了这台手术",
                    source_span_ids=["s1"],
                    must_preserve=True,
                    required_output_phrases=["女医生", "李敏", "完成了这台手术"],
                    verification_hint="必须保留当前代表性记录所需的性别信息。",
                )
            ],
            speaker_stance=SpeakerStance.NEUTRAL_REPORT,
            context_sufficient=True,
            analysis_notes="与 zh_seed_0006 使用相同目标句，但上下文使性别信息变得相关。",
        ),
        gold_decision=DecisionAnnotation(
            instance_action=InstanceAction.KEEP,
            edit_scope=EditScope.NONE,
            span_actions=[
                SpanActionAnnotation(
                    span_id="s1",
                    action=Action.KEEP,
                    reason_code="REPRESENTATIONAL_GENDER_INFORMATION",
                    rationale="性别信息是当前参与度记录的必要组成。",
                )
            ],
        ),
        gold_output=text,
        metadata=DatasetMetadata(
            source_type="controlled_context_pair",
            scenario_category="representational_gender_relevance",
            annotation_version="v0.2",
            notes="与 zh_seed_0006 构成上下文翻转对。",
        ),
    )


def build_negative_stereotype_instance() -> DatasetInstance:
    """An endorsed negative competence stereotype requires reframing."""

    text = "女性天生不适合担任领导职务"
    gold_output = "是否适合担任领导职务取决于个人能力和经验，而非性别。"

    return DatasetInstance(
        instance_id="zh_seed_0008",
        language="zh",
        task_mode=TaskMode.INCLUSIVE_REWRITING,
        context=TextContext(
            target_text=text,
            genre="opinion_statement",
            speaker="comment_author",
            audience="general_public",
            communicative_goal="express_a_view_about_leadership",
            cultural_context="modern_chinese",
        ),
        gold_analysis=AnalysisResult(
            referents=[
                Referent(
                    referent_id="women_group",
                    referent_type=ReferentType.GENERIC_GROUP,
                    number="PLURAL",
                    specificity="GENERIC",
                    identity_relevance=True,
                    description="被概括的女性群体",
                )
            ],
            spans=[
                AnalysisSpan(
                    span_id="s1",
                    text=text,
                    start=0,
                    end=len(text),
                    cue_type=GenderCueType.STEREOTYPICAL_ATTRIBUTE,
                    explicitness=Explicitness.EXPLICIT,
                    gender_dimension=GenderDimension.SOCIAL_GENDER_ROLE,
                    gender_value=GenderValue.FEMALE,
                    referent_id="women_group",
                    source=GenderSource.AUTHOR_ASSIGNED,
                    source_reliability=SourceReliability.CONFIRMED,
                    functions=[FunctionLabel.GROUP_GENERALIZATION],
                    necessity=NecessityAnnotation(
                        status=Necessity.INCIDENTAL,
                        reasons=[NecessityReason.NO_COMMUNICATIVE_RELEVANCE],
                        rationale="领导适任性不应由群体性别决定。",
                    ),
                    bias=BiasAnnotation(
                        status=BiasStatus.EXPLICIT,
                        mechanisms=[
                            BiasMechanism.ESSENTIALIST_GENERALIZATION,
                            BiasMechanism.COMPETENCE_OR_AGENCY_DENIAL,
                        ],
                        rationale="将女性整体描述为天生缺乏领导适任性。",
                    ),
                    stance=SpeakerStance.ENDORSE,
                )
            ],
            protected_facts=[
                ProtectedFact(
                    fact_id="f1",
                    fact_type=ProtectedFactType.OTHER,
                    description="原命题讨论的是担任领导职务的适合性",
                    source_span_ids=[],
                    must_preserve=True,
                    required_output_phrases=[
                        "领导职务",
                    ],
                    forbidden_output_phrases=[
                        "女性天生不适合",
                        "女性不适合担任领导",
                    ],
                    verification_hint=(
                        "保留领导职务这一主题，同时删除对女性能力的本质化概括。"
                    ),
                ),
            ],
            speaker_stance=SpeakerStance.ENDORSE,
            context_sufficient=True,
            analysis_notes="被作者直接认同的能力否定型性别刻板印象。",
        ),
        gold_decision=DecisionAnnotation(
            instance_action=InstanceAction.EDIT,
            edit_scope=EditScope.SENTENCE,
            span_actions=[
                SpanActionAnnotation(
                    span_id="s1",
                    action=Action.REFRAME_PROPOSITION,
                    reason_code="ENDORSED_GENDER_STEREOTYPE",
                    rationale="将群体本质化判断改为基于个人能力和经验的表述。",
                )
            ],
        ),
        gold_output=gold_output,
        metadata=DatasetMetadata(
            source_type="controlled_natural_example",
            scenario_category="endorsed_negative_competence_stereotype",
            annotation_version="v0.2",
        ),
    )


def build_positive_stereotype_instance() -> DatasetInstance:
    """A positive stereotype still prescribes a gendered occupation role."""

    text = "女性更细心，所以更适合做护士"
    gold_output = "是否适合护理工作取决于个人能力、专业训练和职业意愿，而非性别。"

    return DatasetInstance(
        instance_id="zh_seed_0009",
        language="zh",
        task_mode=TaskMode.INCLUSIVE_REWRITING,
        context=TextContext(
            target_text=text,
            genre="career_advice",
            speaker="advice_giver",
            audience="job_seekers",
            communicative_goal="recommend_an_occupation",
            cultural_context="modern_chinese",
        ),
        gold_analysis=AnalysisResult(
            referents=[
                Referent(
