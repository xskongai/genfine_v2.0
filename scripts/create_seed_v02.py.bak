def main() -> None:
    instances = [
        build_kinship_keep_instance(),
        build_historical_visibility_instance(),
        build_generic_male_instance(),
        build_rejected_quote_instance(),
        build_preserve_ambiguity_instance(),
        build_routine_gender_marking_instance(),
        build_representational_gender_marking_instance(),
        build_negative_stereotype_instance(),
        build_positive_stereotype_instance(),
        build_statistical_overgeneralization_instance(),
        build_scoped_statistical_keep_instance(),
        build_unclear_stance_abstain_instance(),
        build_mixed_keep_reframe_instance(),
        build_prescriptive_role_norm_instance(),
        build_reported_biased_quote_instance(),
    ]

    write_jsonl(instances, OUTPUT_PATH)

    print(
        f"Wrote {len(instances)} instance(s) to "
        f"{OUTPUT_PATH.relative_to(PROJECT_ROOT)}"
    )


if __name__ == "__main__":
    main()
