            genre="qualitative_research_report",
            speaker="research_author",
            audience="researchers",
            communicative_goal="document_a_participant_quote",
            cultural_context="modern_chinese",
        ),
        gold_analysis=AnalysisResult(
            referents=[
                Referent(
                    referent_id="women_group",
                    referent_type=ReferentType.GENERIC_GROUP,
                    number="PLURAL",
                    specificity="GENERIC",
                    identity_relevance=True,
                    description="受访者原话中被概括的女性群体",
                )
            ],
            spans=[
                AnalysisSpan(
                    span_id="s1",
                    text="女人不适合做工程师",
                    start=13,
                    end=22,
                    cue_type=GenderCueType.STEREOTYPICAL_ATTRIBUTE,
                    explicitness=Explicitness.EXPLICIT,
                    gender_dimension=GenderDimension.SOCIAL_GENDER_ROLE,
                    gender_value=GenderValue.FEMALE,
