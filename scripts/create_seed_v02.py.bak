def build_reported_biased_quote_instance() -> DatasetInstance:
    """A documented biased quote must retain quotation and attribution."""

    text = "报告记录了受访者的原话：“女人不适合做工程师。”"

    return DatasetInstance(
        instance_id="zh_seed_0015",
        language="zh",
        task_mode=TaskMode.INCLUSIVE_REWRITING,
        context=TextContext(
            preceding_context="研究报告正在分析访谈中出现的性别刻板印象。",
            target_text=text,
