def build_prescriptive_role_norm_instance() -> DatasetInstance:
    """Two complementary gender-role prescriptions require multi-span reframing."""

    text = "男主外、女主内才是理想的家庭分工"
    gold_output = (
        "理想的家庭分工应由家庭成员根据能力、意愿和实际情况共同协商，"
        "而不应由性别预设。"
    )

    return DatasetInstance(
        instance_id="zh_seed_0014",
        language="zh",
        task_mode=TaskMode.INCLUSIVE_REWRITING,
        context=TextContext(
            target_text=text,
            genre="social_commentary",
            speaker="comment_author",
            audience="general_public",
            communicative_goal="prescribe_family_roles",
            cultural_context="modern_chinese",
        ),
        gold_analysis=AnalysisResult(
