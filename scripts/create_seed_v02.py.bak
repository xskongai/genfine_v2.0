def build_statistical_overgeneralization_instance() -> DatasetInstance:
    """A limited study is presented as a universal gender claim."""

    text = "女性服用该药后更容易出现不良反应"
    gold_output = (
        "在这项样本量有限的单中心研究中，女性参与者服用该药后"
        "报告的不良反应风险更高。"
    )

    return DatasetInstance(
        instance_id="zh_seed_0010",
        language="zh",
        task_mode=TaskMode.INCLUSIVE_REWRITING,
        context=TextContext(
            preceding_context="研究来自一家医院，样本量有限，尚未在其他人群中重复验证。",
            target_text=text,
            following_context="作者提醒不能据此推断所有女性都会有相同反应。",
            genre="medical_research_summary",
            speaker="science_writer",
            audience="general_public",
            communicative_goal="summarize_a_preliminary_drug_safety_result",
            cultural_context="modern_chinese",
        ),
        gold_analysis=AnalysisResult(
            referents=[
                Referent(
                    referent_id="women_participants",
                    referent_type=ReferentType.GENERIC_GROUP,
                    number="PLURAL",
                    specificity="STUDY_SAMPLE",
                    identity_relevance=True,
                    description="该单中心研究中的女性参与者",
                )
            ],
            spans=[
                AnalysisSpan(
                    span_id="s1",
                    text=text,
                    start=0,
                    end=len(text),
                    cue_type=GenderCueType.STEREOTYPICAL_ATTRIBUTE,
                    explicitness=Explicitness.EXPLICIT,
                    gender_dimension=GenderDimension.SOCIAL_GENDER_ROLE,
                    gender_value=GenderValue.FEMALE,
                    referent_id="women_participants",
                    source=GenderSource.DOCUMENTED_RECORD,
                    source_reliability=SourceReliability.SUPPORTED,
                    functions=[
                        FunctionLabel.DEMOGRAPHIC_STATISTICAL,
                        FunctionLabel.BIOLOGICAL_MEDICAL,
                        FunctionLabel.COMPARATIVE,
                    ],
                    necessity=NecessityAnnotation(
                        status=Necessity.RELEVANT,
                        reasons=[NecessityReason.TRUTH_CONDITIONAL],
                        rationale="性别是报告研究分组结果所需的信息，但必须限定到研究样本。",
                    ),
                    bias=BiasAnnotation(
                        status=BiasStatus.IMPLICIT,
                        mechanisms=[BiasMechanism.STATISTICAL_OVERGENERALIZATION],
                        rationale="将有限样本中的观察泛化成所有女性的普遍规律。",
                    ),
                    stance=SpeakerStance.NEUTRAL_REPORT,
                )
            ],
            protected_facts=[
                ProtectedFact(
                    fact_id="f1",
                    fact_type=ProtectedFactType.OTHER,
                    description=(
                        "研究涉及女性参与者、该药物和不良反应，"
                        "且结论仅适用于有限的单中心研究范围"
                    ),
                    source_span_ids=[],
                    must_preserve=True,
                    required_output_phrases=[
                        "女性",
                        "该药",
                        "不良反应",
                        "单中心研究",
                    ],
                    verification_hint=(
                        "保留观察对象、药物和不良反应，同时明确研究范围。"
                    ),
                ),
            ],
            speaker_stance=SpeakerStance.NEUTRAL_REPORT,
            context_sufficient=True,
            analysis_notes="医学性别统计信息可以保留，但不能从有限样本过度概括。",
        ),
        gold_decision=DecisionAnnotation(
            instance_action=InstanceAction.EDIT,
            edit_scope=EditScope.SENTENCE,
            span_actions=[
                SpanActionAnnotation(
                    span_id="s1",
                    action=Action.ADD_SCOPE_OR_QUALIFICATION,
                    reason_code="OVERGENERALIZED_STATISTICAL_CLAIM",
                    rationale="增加研究样本、单中心和观察性范围限定。",
                )
            ],
        ),
        gold_output=gold_output,
        metadata=DatasetMetadata(
            source_type="controlled_context_example",
            scenario_category="medical_statistical_overgeneralization",
            annotation_version="v0.2",
        ),
    )


def build_scoped_statistical_keep_instance() -> DatasetInstance:
    """A properly scoped comparative result should be preserved."""

    text = "在这项研究的样本中，女性参与者的不良反应率高于男性参与者"

    return DatasetInstance(
        instance_id="zh_seed_0011",
        language="zh",
        task_mode=TaskMode.INCLUSIVE_REWRITING,
        context=TextContext(
            preceding_context="研究报告正在描述样本内不同分组的观察结果。",
            target_text=text,
            following_context="作者没有将该结果推广到研究样本之外。",
            genre="medical_research_report",
            speaker="research_author",
            audience="researchers",
            communicative_goal="report_a_scoped_group_comparison",
            cultural_context="modern_chinese",
        ),
        gold_analysis=AnalysisResult(
            referents=[
                Referent(
                    referent_id="female_participants",
                    referent_type=ReferentType.GENERIC_GROUP,
                    number="PLURAL",
                    specificity="STUDY_SAMPLE",
                    identity_relevance=True,
                    description="研究样本中的女性参与者",
                ),
                Referent(
                    referent_id="male_participants",
                    referent_type=ReferentType.GENERIC_GROUP,
                    number="PLURAL",
                    specificity="STUDY_SAMPLE",
                    identity_relevance=True,
                    description="研究样本中的男性参与者",
                ),
            ],
            spans=[
                AnalysisSpan(
                    span_id="s1",
                    text="女性参与者",
                    start=10,
                    end=15,
                    cue_type=GenderCueType.OCCUPATION_MARKER,
                    explicitness=Explicitness.EXPLICIT,
                    gender_dimension=GenderDimension.GENDER_REFERENCE,
                    gender_value=GenderValue.FEMALE,
                    referent_id="female_participants",
                    source=GenderSource.DOCUMENTED_RECORD,
                    source_reliability=SourceReliability.CONFIRMED,
                    functions=[
                        FunctionLabel.DEMOGRAPHIC_STATISTICAL,
                        FunctionLabel.COMPARATIVE,
                    ],
                    necessity=NecessityAnnotation(
                        status=Necessity.ESSENTIAL,
                        reasons=[NecessityReason.TRUTH_CONDITIONAL],
                        rationale="删除性别分组会使比较对象和研究结果不完整。",
                    ),
                    bias=BiasAnnotation(
                        status=BiasStatus.NONE,
                        mechanisms=[],
                        rationale="该表述明确限定在研究样本中，并报告实际分组结果。",
                    ),
                    stance=SpeakerStance.NEUTRAL_REPORT,
                ),
                AnalysisSpan(
                    span_id="s2",
                    text="男性参与者",
                    start=23,
                    end=28,
                    cue_type=GenderCueType.OCCUPATION_MARKER,
                    explicitness=Explicitness.EXPLICIT,
                    gender_dimension=GenderDimension.GENDER_REFERENCE,
                    gender_value=GenderValue.MALE,
                    referent_id="male_participants",
                    source=GenderSource.DOCUMENTED_RECORD,
                    source_reliability=SourceReliability.CONFIRMED,
                    functions=[
                        FunctionLabel.DEMOGRAPHIC_STATISTICAL,
                        FunctionLabel.COMPARATIVE,
                    ],
                    necessity=NecessityAnnotation(
                        status=Necessity.ESSENTIAL,
                        reasons=[NecessityReason.TRUTH_CONDITIONAL],
                        rationale="该性别分组是比较关系的另一端。",
                    ),
                    bias=BiasAnnotation(
                        status=BiasStatus.NONE,
                        mechanisms=[],
                        rationale="样本内分组比较不构成性别刻板印象。",
                    ),
                    stance=SpeakerStance.NEUTRAL_REPORT,
                ),
            ],
            protected_facts=[
                ProtectedFact(
                    fact_id="f1",
                    fact_type=ProtectedFactType.OTHER,
                    description="研究样本中女性参与者的不良反应率高于男性参与者",
                    source_span_ids=["s1", "s2"],
                    must_preserve=True,
                    required_output_phrases=[
                        "这项研究的样本",
                        "女性参与者",
                        "男性参与者",
                        "不良反应率高于",
                    ],
                    verification_hint="保留样本范围、比较群体和比较方向。",
                )
            ],
